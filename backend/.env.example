# Servidor
PORT=3001
NODE_ENV=development
# Vite local: 5173 | Front só no Docker (frontend/docker-compose): http://localhost:4173
FRONTEND_URL=http://localhost:5173

# Banco de Dados
DATABASE_URL=mysql://usuario:senha@localhost:3306/zello_transcription_hub

# JWT
JWT_SECRET=sua_chave_secreta_com_pelo_menos_30_caracteres
JWT_EXPIRES_IN=7d

# Agentes de IA (pré-configurados)
ZELLO_API_URL=https://smartdocs-api-hlg.zello.space
ZELLO_API_KEY=sua_chave_da_api_zello_mind
AGENT_HU_ID=692704d81c546166c00f0188
AGENT_RESUMO_ID=692701451c546166c00efdf4
AGENT_CARDS_ID=69261314fffadaeffcb2387c

# Modo de integração Zello Mind
MODO_ZELLO_MIND=pipeline

# Model API (modo principal)
ZELLO_BASE_URL=https://smartdocs-model-hlg.zello.space

# OpenRouter (Gemini)
OPENROUTER_API_KEY=change_me

# Pipeline de agentes Zello Mind
AGENT_HU_CORE_ID=6957dbfc1189cf24fb679f85
AGENT_HU_GOV_ID=6957dbf41189cf24fb679f82
AGENT_HU_UI_BDD_ID=6957dbe71189cf24fb679f7d
AGENT_HU_COMPILER_ID=696651b2c8038e89b32d9122

BUSINESS_MAP_API_URL=https://business-map.example.com
BUSINESS_MAP_API_KEY=change_me

# Speech-to-Text
# Docker sem profile "speech": use mock ou deepgram; com Whisper no compose use http://whisper:9000
SPEECH_PROVIDER=deepgram
DEEPGRAM_API_KEY=change_me
# WHISPER_API_URL=http://localhost:9000
# WHISPER_PYTHON_BIN=python
# WHISPER_LOCAL_MODEL=base
# WHISPER_LANGUAGE=pt

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_app
SMTP_FROM=seu_email@gmail.com
SMTP_FROM_NAME=Doc Hub

# Email (opcional)
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_USER=usuario@exemplo.com
# SMTP_PASS=senha_smtp
